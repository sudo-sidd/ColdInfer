# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# ML datasets and downloaded data (auto-populated at runtime)
data/*
!data/README.txt

# Compiled weight headers and staging files (auto-generated at runtime)
weights/*
!weights/README.txt

# PyTorch model checkpoints
*.pt

# Compiled C++ inference binary
infer

# TFLM source clone (large — rebuild with setup_tflm.sh)
third_party/tflite-micro/

# TFLM built artifacts (library + headers)
third_party/tflm_build/

# TFLM compiled benchmark binary
tflm_bench

# Exported .tflite and C-array model headers
weights/*.tflite
weights/*_tflm_model.h
